rules_version = '2';

// Firestore ne sert qu'à la Vigie (analyse produit interne), et SEULES les
// Cloud Functions (SDK admin, qui ignore ces règles) y écrivent.
// L'app et le grand public : aucun accès, ni lecture ni écriture.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
