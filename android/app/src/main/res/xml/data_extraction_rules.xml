<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ : même règle que backup_rules.xml, pour la sauvegarde cloud
     ET le transfert d'appareil à appareil. Audit du 02/09/2026. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml"/>
    </device-transfer>
</data-extraction-rules>
